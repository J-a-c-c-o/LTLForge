<?xml version="1.0" encoding="UTF-8"?>
<pnml>
  <net id="simple" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <name><text>Simple example</text></name>
    <page id="page1">
      <place id="p1">
        <initialMarking>
          <text>1</text>
        </initialMarking>
      </place>
      <place id="p2">
        <initialMarking>
          <text>0</text>
        </initialMarking>
      </place>
      <place id="p3">
        <initialMarking>
          <text>0</text>
        </initialMarking>
      </place>

      <transition id="t1" />
      <transition id="t2" />
      <transition id="t3" />
      <arc source="p1" target="t1" />
      <arc source="t1" target="p2" />
      <arc source="p2" target="t2" />
      <arc source="t2" target="p3" />
      <arc source="p3" target="t3" />
      <arc source="t3" target="p2" />
    </page>
  </net>
</pnml>
